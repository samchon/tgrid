{
  "name": "tgrid",
  "version": "1.2.1",
  "main": "lib/node/index.js",
  "typings": "lib/node/index.d.ts",
  "browser": "lib/browser/index.js",
  "exports": {
    ".": {
      "types": "./lib/node/index.d.ts",
      "browser": {
        "require": "./lib/browser/index.js",
        "import": "./lib/browser/index.mjs"
      },
      "react-native": {
        "require": "./lib/browser/index.js",
        "import": "./lib/browser/index.mjs"
      },
      "node": {
        "require": "./lib/node/index.js",
        "import": "./lib/node/index.mjs"
      },
      "require": "./lib/node/index.js",
      "import": "./lib/node/index.mjs"
    }
  },
  "description": "Grid Computing Framework for TypeScript",
  "author": {
    "name": "Jeongho Nam",
    "email": "samchon.github@gmail.com",
    "url": "https://github.com/samchon"
  },
  "scripts": {
    "build": "npm run build:main && npm run build:test",
    "build:main": "rimraf lib && ttsc --project tsconfig.node.json && ttsc --project tsconfig.browser.json && rollup -c",
    "build:test": "rimraf bin && ttsc --project test/tsconfig.json && ttsc --project test/browser/tsconfig.json",
    "dev": "rimraf bin && ttsc --project test/tsconfig.json --watch",
    "prettier": "prettier src --write && prettier test --write",
    "test": "npm run test:node && npm run test:browser",
    "test:browser": "ttsx --project test/tsconfig.json test/browser/index.ts",
    "test:node": "ttsx test/node/index.ts"
  },
  "dependencies": {
    "@types/node": "^20.11.30",
    "@types/websocket": "^1.0.10",
    "@types/ws": "^7.4.7",
    "tstl": "3.0.0",
    "ws": "^7.5.3"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@ttsc/unplugin": "0.30.4",
    "@ttsc/paths": "0.30.4",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/browserify": "^12.0.40",
    "@types/puppeteer": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^5.33.0",
    "@typescript-eslint/parser": "^5.33.0",
    "browserify": "^17.0.0",
    "eslint": "^8.57.0",
    "local-web-server": "^2.6.0",
    "mv": "^2.1.1",
    "prettier": "^3.2.5",
    "puppeteer": "^22.4.1",
    "rimraf": "^5.0.5",
    "rollup": "^4.13.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "tslib": "^2.6.2",
    "ttsc": "0.30.4",
    "typescript": "7.0.2",
    "whatwg-fetch": "^3.6.2"
  },
  "homepage": "https://tgrid.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/tgrid"
  },
  "bugs": {
    "url": "https://github.com/samchon/tgrid/issues"
  },
  "license": "MIT",
  "keywords": [
    "TGrid",
    "typescript grid computing framework",
    "realtime network communication",
    "RPC",
    "RFC",
    "ROC",
    "OON",
    "remote procedure call",
    "remote function call",
    "remote object call",
    "object oriented network",
    "WebSocket",
    "Worker",
    "SharedWorker",
    "NestJS",
    "nestia",
    "tRPC",
    "thread",
    "process"
  ],
  "sideEffects": false,
  "files": [
    "LICENSE",
    "README.md",
    "lib",
    "src"
  ],
  "packageManager": "pnpm@10.5.2"
}
